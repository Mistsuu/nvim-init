snippet ofiler
  int ${1:fd} = open("${2:file.txt}", O_RDONLY);
  if ($1 < 0) {
    perror("open $2 to read failed");
    exit(1);
  }
  $0
  close($1);

snippet ofilew
  int ${1:fd} = open("${2:file.txt}", O_WRONLY | O_CREAT | O_TRUNC, 0644);
  if ($1 < 0) {
    perror("open $2 to write failed");
    exit(1);
  }
  $0
  close($1);

snippet ofilerw
  int ${1:fd} = open("${2:file.txt}", O_RDWR, 0644);
  if ($1 < 0) {
    perror("open $2 to read/write failed");
    exit(1);
  }
  $0
  close($1);

